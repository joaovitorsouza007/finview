# Copie este arquivo para .env e preencha os valores.
# Veja o README (seção "Conectar o banco do usuário") para instruções completas.

# Banco de dados (SQLite em dev; use PostgreSQL em produção)
DATABASE_URL="file:./dev.db"

# Segurança — troque por uma chave longa e aleatória em produção
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Porta do servidor
PORT=4000

# ---------------------------------------------------------------------------
# Open Banking (Pluggy)
# Configure UMA ÚNICA VEZ. Sem estas chaves o app roda em modo demonstração
# (dados fictícios), o que permite testar o fluxo completo localmente.
# ---------------------------------------------------------------------------
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Chave de criptografia dos tokens de acesso (AES-256-GCM).
# Gere uma com:  openssl rand -hex 32
ENCRYPTION_KEY=""

# URL do frontend para o redirecionamento após a autorização
FRONTEND_URL="http://localhost:5173"
